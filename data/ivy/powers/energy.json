{
    "$schema": "https://raw.githubusercontent.com/SnaveSutit/origins-mod-json-schemas/refs/heads/schemas/apoli/power.json",
    "type":"origins:multiple",

    "name":"Soul-powered Core",
    "description":"Ivy passively generates energy that can be used for cybernetic abilities. If it runs out while she's at no integrity, large consequences await.",


    "energy":{
        "type":"origins:resource",
        "min":0,
        "max":1000,
        "start_value":1000,
        "hud_render": {
            "bar_index": 2
        },
        "min_action":{
            "type":"origins:and",
            "actions":[
                {            
                    "type":"origins:if_else",
                    "condition":{
                        "type":"origins:resource",
                        "resource":"*:base_integrity",
                        "comparison":"<=",
                        "compare_to":150
                    },
                    "if_action":{
                        "type":"origins:change_resource",
                        "resource":"*:*_powerdown",
                        "change":1,
                        "operation":"set"
                    }
                },
                {
                   "type":"origins:change_resource",
                    "resource":"*:cybernetics_booster",
                    "change":0,
                    "operation":"set" 
                },
                {
                    "type":"origins:if_else",
                    "condition":{
                        "type":"origins:resource",
                        "resource":"*:cybernetics_repair",
                        "compare_to":1,
                        "comparison":"=="
                    },
                    "if_action":{
                        "type":"origins:trigger_cooldown",
                        "power":"*:cybernetics_repair_energycd"
                    }
                },
                {
                   "type":"origins:change_resource",
                    "resource":"*:cybernetics_repair",
                    "change":0,
                    "operation":"set" 
                },
                {
                   "type":"origins:change_resource",
                    "resource":"*:cybernetics_armblade",
                    "change":0,
                    "operation":"set" 
                },
                {
                   "type":"origins:change_resource",
                    "resource":"*:cybernetics_vision",
                    "change":0,
                    "operation":"set" 
                }

            ]
        }
    },

    "powerdown": {
        "type":"origins:resource",
        "min":0,
        "max":1,
        "start_value":0
    },

    "darkness":{
        "type": "apoli:action_over_time",
        "rising_action": {
            "type": "apoli:apply_effect",
            "effect": {
                "effect": "minecraft:darkness",
                "duration": 100
            }
        },
        "condition": {
            "type": "apoli:and",
            "conditions": [
                {"type": "apoli:resource","compare_to": 1,"comparison": "==","resource": "*:*_powerdown"},
                {"type": "apoli:resource","resource": "*:cybernetics_emergency","compare_to": 0,"comparison": "=="}
            ]
        },
        "entity_action": {
            "type": "apoli:apply_effect",
            "effect": {
                "effect": "minecraft:darkness",
                "duration": 100
            }
        },
        "falling_action": {
            "type": "apoli:clear_effect",
            "effect": "minecraft:darkness"
        },
        "interval": 20
    },

    "weakened":{
        "type": "apoli:conditioned_attribute",
        "tick_rate": 5,
        "condition": {
            "type": "apoli:and",
            "conditions": [
                {"type": "apoli:resource","compare_to": 1,"comparison": "==","resource": "*:*_powerdown"},
                {"type": "apoli:resource","resource": "*:cybernetics_emergency","compare_to": 0,"comparison": "=="}
            ]
        },
        "modifiers": [
            {
                "attribute": "minecraft:generic.attack_speed",
                "operation": "multiply_total",
                "value": -0.5
            },

            {
                "attribute": "minecraft:generic.movement_speed",
                "operation": "multiply_total",
                "value": -0.25
            }
        ]
    },

    "powerup":{
        "type":"origins:action_over_time",
        "entity_action":{
            "type":"origins:if_else",
            "condition":{
                "type":"origins:and",
                "conditions":[
                    {
                        "type":"origins:resource",
                        "resource":"*:*_powerdown",
                        "comparison":"==",
                        "compare_to":1
                    },
                    {
                        "type":"origins:or",
                        "conditions":[
                            {
                                "type":"origins:resource",
                                "resource":"*:base_hpdown",
                                "comparison":"==",
                                "compare_to":0
                            }
                        ]
                    }
                ]
            },
            "if_action":{
                "type": "apoli:and",
                "actions": [
                    {
                        "type": "origins:change_resource",
                        "change": 0,
                        "operation": "set",
                        "resource": "*:*_powerdown"
                    },
                    {
                        "type": "apoli:change_resource",
                        "change": 0,
                        "operation": "set",
                        "resource": "*:cybernetics_emergency"
                    }
                ]
            }
        }
    },


    "regen":{
        "type":"origins:action_over_time",
        "entity_action":{
            "type":"origins:if_else",
            "condition":{
                "type":"origins:resource",
                "resource":"*:*_powerdown",
                "comparison":"==",
                "compare_to":0
            },
            "if_action":{
                "type": "origins:modify_resource",
                "modifier": {
                    "operation": "add_base_early",
                    "value": 0,
                    "resource": "*:*_regenrate"
                },
                "resource": "*:*_energy"
            },
            "else_action":{
                "type":"origins:change_resource",
                "change":1,
                "operation":"add",
                "resource":"*:*_energy" 
            }
        },
        "condition":{
            "type":"origins:and",
            "conditions":[
                {
                   "type":"origins:resource",
                    "resource":"*:cybernetics_booster",
                    "compare_to":0,
                    "comparison":"==" 
                },
                {
                   "type":"origins:resource",
                    "resource":"*:cybernetics_vision",
                    "compare_to":0,
                    "comparison":"==" 
                },
                {
                   "type":"origins:resource",
                    "resource":"*:cybernetics_armblade",
                    "compare_to":0,
                    "comparison":"==" 
                },
                {
                   "type":"origins:resource",
                    "resource":"*:cybernetics_repair",
                    "compare_to":0,
                    "comparison":"==" 
                }
            ]
        }
    },

    "regenrate":{
        "type":"origins:resource",
        "max":1000,
        "min":0,
        "start_value":10
    }
}