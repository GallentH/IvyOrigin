{
    "$schema": "https://raw.githubusercontent.com/SnaveSutit/origins-mod-json-schemas/refs/heads/schemas/apoli/power.json",
    "name":"Figura Sync",
    "description": "Built to work relatively seemlessly with Ivy's figura!",
    "hidden": true,
    "type": "apoli:multiple",

    "state":{
        "type":"origins:action_over_time",
        "interval":5,
        "entity_action": {
            "type":"apoli:execute_command",
            "command": "function ivy:sync/state"
        }
    },

    "powers":{
        "type":"origins:action_over_time",
        "interval":20,
        "entity_action": {
            "type":"apoli:execute_command",
            "command": "function ivy:sync/powers"
        }
    },

    "events":{
        "type": "apoli:action_on_callback",
        "entity_action_added": {"type":"apoli:execute_command","command":"function ivy:sync/state"},
        "entity_action_removed": {"type":"apoli:execute_command","command": "trigger ivy.figura set 0"}
    }
}