{
    "$schema": "https://raw.githubusercontent.com/SnaveSutit/origins-mod-json-schemas/refs/heads/schemas/apoli/power.json",
    "type": "origins:multiple",
    "name": "Cybernetics",
    "description": "Ivy's cybernetic body comes with multiple useful abilities, though they all consume energy.",
    "badges": [
        {
            "sprite": "minecraft:textures/item/iron_sword.png",
            "text": "Arm Blade:\nCan convert vanilla swords into components that can be installed in her arm. These have half the durability and are damaged on death, only work with an empty hand, and can be repaired at an anvil. Can be combined with a mending book to use XP to repair."
        },
        {
            "sprite": "minecraft:textures/mob_effect/speed.png",
            "text": "Agility Booster:\nIncreases speed while sprinting, and consumes extra energy to boost jumps."
        },
        {
            "sprite": "minecraft:textures/mob_effect/night_vision.png",
            "text": "Enhanced Optics:\nSlightly increases Ivy's ability to see in the dark."
        },
        {
            "sprite": "minecraft:textures/item/netherite_scrap.png",
            "text": "Repair:\nDrains a lot of energy over time to restore system integrity. \nInterupted and put on cooldown by taking damage, and much less efficient after 50% mark."
        }
    ],
    "selector": {
        "type": "origins:resource",
        "min": 0,
        "max": 7,
        "start_value": 1,
        "hud_render": {
            "sprite_location": "origins:textures/gui/community/spiderkolo/resource_bar_points_01.png",
            "bar_index": 4
        }
    },
    "primary": {
        "type": "origins:active_self",
        "entity_action": {
            "type": "apoli:and",
            "actions": [
                {
                    "type": "origins:if_else_list",
                    "actions": [
                        {
                            "condition": {
                                "type": "origins:or",
                                "conditions": [
                                    {
                                        "type": "origins:resource",
                                        "resource": "*:*_selector",
                                        "comparison": "==",
                                        "compare_to": 4
                                    },
                                    {
                                        "type": "origins:resource",
                                        "resource": "*:energy_powerdown",
                                        "comparison": "==",
                                        "compare_to": 1
                                    }
                                ]
                            },
                            "action": {
                                "type": "origins:if_else",
                                "condition": {
                                    "type":"origins:and",
                                    "conditions":[
                                        {
                                            "type": "origins:resource",
                                            "resource": "*:*_repair",
                                            "comparison": "==",
                                            "compare_to": 0
                                        },
                                        {
                                            "type":"origins:resource",
                                            "resource":"*:*_repair_energycd",
                                            "comparison":"==",
                                            "compare_to":0
                                        },
                                        {
                                            "type":"origins:resource",
                                            "resource":"*:*_repair_damagecd",
                                            "comparison":"==",
                                            "compare_to":0
                                        },
                                        {
                                            "type": "apoli:resource",
                                            "compare_to": 50,
                                            "comparison": ">=",
                                            "resource": "*:energy_energy"
                                        },
                                        {
                                            "type": "apoli:resource",
                                            "compare_to": 750,
                                            "comparison": "<",
                                            "resource": "*:base_integrity"
                                        }
                                    ]
                                },
                                "if_action":{
                                    "type":"origins:change_resource",
                                    "change":1,
                                    "resource": "*:*_repair",
                                    "operation":"set"
                                },
                                "else_action":{
                                    "type":"origins:change_resource",
                                    "change":0,
                                    "resource": "*:*_repair",
                                    "operation":"set"
                                }
                            }
                        },
                        {
                            "condition": {
                                "type":"apoli:and",
                                "conditions": [
                                    {
                                        "type": "origins:resource",
                                        "resource": "*:*_selector",
                                        "comparison": "==",
                                        "compare_to": 1
                                    },
                                    {
                                        "type": "apoli:resource",
                                        "resource": "*:energy_energy",
                                        "compare_to": 100,
                                        "comparison": ">"
                                    }
                                ]
                            },
                            "action": {
                                "type": "origins:if_else",
                                "condition": {
                                    "type": "origins:resource",
                                    "resource": "*:*_armblade",
                                    "comparison": "==",
                                    "compare_to": 0
                                },
                                "if_action":{
                                    "type": "origins:and",
                                    "actions": [
                                        {
                                            "type":"origins:change_resource",
                                            "resource": "*:*_armblade",
                                            "change":1,
                                            "operation":"set"
                                        },
                                        {
                                            "type": "apoli:change_resource",
                                            "resource": "*:energy_energy",
                                            "change": -100,
                                            "operation": "add"
                                        }
                                    ]
                                },
                                "else_action":{
                                    "type":"origins:change_resource",
                                    "resource": "*:*_armblade",
                                    "change":0,
                                    "operation":"set"
                                }
                            }
                        },
                        {
                            "condition": { "compare_to": 2, "type": "origins:resource", "resource": "*:*_selector", "comparison": "==" },
                            "action": {
                                "type": "origins:if_else",
                                "condition": { "resource": "*:*_booster", "comparison": "==", "compare_to": 0, "type": "origins:resource" },
                                "if_action":{ "resource": "*:*_booster", "change":1, "operation":"set", "type":"origins:change_resource" },
                                "else_action":{ "resource": "*:*_booster", "change":0, "operation":"set", "type":"origins:change_resource" }
                            }
                        },
                        {
                            "condition": { "compare_to": 3, "type": "origins:resource", "resource": "*:*_selector", "comparison": "==" },
                            "action": {
                                "type": "origins:if_else",
                                "condition": { "resource": "*:*_vision", "comparison": "==", "compare_to": 0, "type": "origins:resource" },
                                "if_action":{ "resource": "*:*_vision", "change":1, "operation":"set", "type":"origins:change_resource" },
                                "else_action":{ "resource": "*:*_vision", "change":0, "operation":"set", "type":"origins:change_resource" }
                            }
                        }
                    ]
                },
                {"type":"apoli:execute_command","command":"function ivy:sync/powers"}
            ]
        }
    },


    "emergency":{
        "type": "apoli:resource",
        "max": 1,
        "min": 0,
        "start_value": 0
    },

    "blinded":{
        "type": "apoli:action_over_time",
        "condition": {"type": "apoli:resource","compare_to": 1,"comparison": "==","resource": "*:*_emergency"},
        "rising_action": {
            "type": "apoli:apply_effect",
            "effect": {
                "effect": "minecraft:blindness",
                "duration": 100
            }
        },
        "entity_action": {
            "type": "apoli:apply_effect",
            "effect": {
                "effect": "minecraft:blindness",
                "duration": 100
            }
        },
        "falling_action": {
            "type": "apoli:clear_effect",
            "effect": "minecraft:blindness"
        },
        "interval": 20
    },

    "weakened":{
        "type": "apoli:conditioned_attribute",
        "tick_rate": 5,
        "condition": {"type": "apoli:resource","compare_to": 1,"comparison": "==","resource": "*:energy_powerdown"},
        "modifiers": [
            {
                "attribute": "minecraft:generic.attack_speed",
                "operation": "multiply_total",
                "value": -0.9
            },
            {
                "attribute": "minecraft:generic.attack_damage",
                "operation": "multiply_total",
                "value": -1
            },

            {
                "attribute": "minecraft:generic.movement_speed",
                "operation": "multiply_total",
                "value": -0.75
            }
        ]
    },

    "energyregen":{
        "type": "apoli:action_over_time",
        "interval": 20,
        "condition": {
            "type": "apoli:and",
            "conditions": [
                {
                    "type": "apoli:resource",
                    "resource": "*:*_emergency",
                    "compare_to": 1,
                    "comparison": "=="
                },
                {
                    "type": "apoli:resource",
                    "compare_to": 0,
                    "comparison": "==",
                    "resource": "*:*_repair"
                }
            ]
        },
        "entity_action": {
            "type": "apoli:change_resource",
            "change": 5,
            "operation": "add",
            "resource": "*:energy_energy"
        }
    },

    "intregen":{
        "type": "apoli:action_over_time",
        "condition": {
            "type": "apoli:resource",
            "compare_to": 1,
            "comparison": "==",
            "resource": "*:*_emergency"
        },
        "entity_action": {
            "type": "apoli:change_resource",
            "change": 1,
            "operation": "add",
            "resource": "*:base_integrity"
        },
        "interval": 60
    },

    "emergencycd":{
        "type": "apoli:cooldown",
        "cooldown": 600,
        "hud_render":{
            "should_render": true,
            "sprite_location": "origins:textures/gui/community/spiderkolo/resource_bar_02.png",
            "bar_index": 14,
            "condition": {
                "type": "origins:resource",
                "resource": "*:*_emergencycd",
                "compare_to": 0,
                "comparison": ">"
            }
        }

    },

    "exitemergency":{
        "condition": {"type": "apoli:resource","compare_to": 1,"comparison": "==","resource": "*:*_emergency"},
        "type": "apoli:self_action_when_hit",
        "entity_action": {
            "type": "apoli:and",
            "actions": [
                {
                    "type": "apoli:change_resource",
                    "change": 0,
                    "operation": "set",
                    "resource": "*:*_emergency"
                },
                {
                    "type": "apoli:trigger_cooldown",
                    "power": "*:*_emergencycd"
                }
            ]
        }
    },

    "secondary": {
        "type": "origins:active_self",
        "key": {
            "key": "key.origins.secondary_active"
        },
        "entity_action": {
            "type":"apoli:and",
            "actions":[
                {
                    "type": "origins:if_else_list",
                    "actions": [
                        {
                            "condition": {"type": "apoli:resource","compare_to": 1,"comparison": "==","resource": "*:energy_powerdown"},
                            "action": {
                                "type": "apoli:if_else",
                                "condition": {
                                    "type": "apoli:and",
                                    "conditions": [
                                        {"type": "apoli:resource","compare_to": 0,"comparison": "==","resource": "*:*_emergency"},
                                        {"type": "apoli:resource","compare_to": 0,"comparison": "==","resource": "*:*_emergencycd"}
                                    ]
                                },
                                "if_action": {
                                    "type": "apoli:change_resource",
                                    "change": 1,
                                    "operation": "set",
                                    "resource": "*:*_emergency"
                                },
                                "else_action": {
                                    "type": "apoli:change_resource",
                                    "change": 0,
                                    "operation": "set",
                                    "resource": "*:*_emergency"
                                }
                            }
                        },
                        {
                            "action": {
                                "type": "origins:change_resource",
                                "resource": "*:*_selector",
                                "change": 4,
                                "operation": "set"
                            },
                            "condition": {
                                "type": "origins:and",
                                "conditions": [
                                    {
                                        "type": "origins:sneaking"
                                    },
                                    {
                                        "type": "origins:resource",
                                        "resource": "*:*_selector",
                                        "compare_to": 1,
                                        "comparison": "<="
                                    }
                                ]
                            }
                        },
                        {
                            "action": {
                                "type": "origins:change_resource",
                                "resource": "*:*_selector",
                                "change": -1,
                                "operation": "add"
                            },
                            "condition": {
                                "type": "origins:sneaking"
                            }
                        },
                        {
                            "action": {
                                "type": "origins:change_resource",
                                "resource": "*:*_selector",
                                "change": 1,
                                "operation": "set"
                            },
                            "condition": {
                                "type": "origins:resource",
                                "resource": "*:*_selector",
                                "compare_to": 4,
                                "comparison": ">="
                            }
                        },
                        {
                            "action": {
                                "type": "origins:change_resource",
                                "resource": "*:*_selector",
                                "change": 1,
                                "operation": "add"
                            },
                            "condition": { "type": "origins:constant", "value": true }
                        }
                    ]
                },
                {"type":"apoli:execute_command","command":"function ivy:sync/powers"}
            ]
        }
    },


    "armblade": {
        "type": "origins:resource",
        "min": 0,
        "max": 1,
        "start_value": 0
    },



    "booster": {
        "type": "origins:resource",
        "min": 0,
        "max": 1,
        "start_value": 0
    },
    "booster_sprint": {
        "type": "origins:conditioned_attribute",
        "tick_rate": 3,
        "condition": {
            "type": "origins:and",
            "conditions": [
                {
                    "type": "origins:sprinting"
                },
                {
                    "type": "origins:resource",
                    "resource": "*:*_booster",
                    "comparison": "==",
                    "compare_to": 1
                }
            ]
        },
        "modifier": {
            "attribute": "minecraft:generic.movement_speed",
            "operation": "multiply_base",
            "value": 0.2,
            "name": "Agility Booster"
        }
    },
    "booster_sprintdrain": {
        "type": "origins:action_over_time",
        "entity_action": {
            "type": "origins:change_resource",
            "resource": "*:energy_energy",
            "change": -33,
            "operation": "add"
        },
        "condition": {
            "type": "origins:and",
            "conditions": [
                {
                    "type": "origins:sprinting"
                },
                {
                    "type": "origins:resource",
                    "resource": "*:*_booster",
                    "comparison": "==",
                    "compare_to": 1
                }
            ]
        }
    },
    "booster_jump": {
        "type": "origins:modify_jump",
        "entity_action": {
            "type": "origins:change_resource",
            "resource": "*:energy_energy",
            "change": -125,
            "operation": "add"
        },
        "modifier": {
            "operation": "multiply_base_additive",
            "value": 0.5
        },
        "condition": {
            "type": "origins:and",
            "conditions": [
                {
                    "type": "origins:climbing",
                    "inverted": true
                },
                {
                    "type": "origins:block_collision",
                    "block_condition": {
                        "type": "origins:fluid",
                        "fluid_condition": {
                            "type": "origins:in_tag",
                            "tag": "minecraft:water"
                        }
                    },
                    "inverted": true
                },
                {
                    "type": "origins:block_collision",
                    "block_condition": {
                        "type": "origins:fluid",
                        "fluid_condition": {
                            "type": "origins:in_tag",
                            "tag": "minecraft:lava"
                        }
                    },
                    "inverted": true
                },
                {
                    "type": "origins:resource",
                    "resource": "*:*_booster",
                    "comparison": "==",
                    "compare_to": 1
                },
                {
                    "type": "origins:resource",
                    "resource": "*:energy_energy",
                    "comparison": ">=",
                    "compare_to": 125
                }
            ]
        }
    },



    "vision": {
        "type": "origins:resource",
        "min": 0,
        "max": 1,
        "start_value": 0
    },
    "vision_true": {
        "type": "origins:night_vision",
        "strength": 0.2,
        "condition": {
            "type": "origins:resource",
            "resource": "*:*_vision",
            "comparison": "==",
            "compare_to": 1
        }
    },
    "vision_drain": {
        "type": "origins:action_over_time",
        "entity_action": {
            "type": "origins:change_resource",
            "resource": "*:energy_energy",
            "change": -20,
            "operation": "add"
        },
        "condition": {
            "type": "origins:resource",
            "resource": "*:*_vision",
            "comparison": "==",
            "compare_to": 1
        }
    },


    "repair": {
        "type": "origins:resource",
        "min": 0,
        "max": 1,
        "start_value": 0
    },
    "repair_main":{
        "type":"origins:action_over_time",
        "interval":20,
        "entity_action": {
            "type": "apoli:if_else",
            "condition": {"type": "apoli:resource","compare_to": 750,"comparison": "<","resource": "*:base_integrity"},
            "if_action": {
                "type":"origins:and",
                "actions":[
                    {
                        "type": "apoli:if_else",
                        "condition": {
                            "type": "apoli:resource",
                            "compare_to": 500,
                            "comparison": "<",
                            "resource": "*:base_integrity"
                        },
                        "if_action": {
                            "type":"origins:change_resource",
                            "resource":"*:base_integrity",
                            "change":10,
                            "operation":"add"
                        },
                        "else_action": {
                            "type": "apoli:change_resource",
                            "resource": "*:base_integrity",
                            "change": 2,
                            "operation": "add"
                        }
                    },

                    {
                        "type":"origins:change_resource",
                        "resource":"*:energy_energy",
                        "change":-50,
                        "operation":"add"
                    },
                    {
                        "type":"origins:execute_command",
                        "command":"function ivy:recalc"
                    }
                ]
            },
            "else_action": {
                "type": "apoli:change_resource","change": 0,"operation": "set","resource": "*:*_repair"
            }
        },
        "condition":{
            "type":"origins:resource",
            "comparison":"==",
            "compare_to":1,
            "resource":"*:*_repair"
        }
    },
    "repair_cancel":{
        "type":"origins:self_action_when_hit",
        "entity_action":{
            "type":"origins:and",
            "actions":[
                {
                    "type":"origins:change_resource",
                    "resource":"*:*_repair",
                    "change":0,
                    "operation":"set"
                },
                {
                    "type":"origins:trigger_cooldown",
                    "power":"*:*_repair_damagecd"
                }
            ]
        },
        "condition":{
            "type":"origins:resource",
            "comparison":"==",
            "compare_to":1,
            "resource":"*:*_repair"
        }
    },
    "repair_damagecd":{
        "type": "origins:cooldown",
        "cooldown": 6000,
        "hud_render": {
            "sprite_location":"origins:textures/gui/community/huang/resource_bar_02.png",
            "bar_index": 1,
            "condition": {
                "type": "origins:resource",
                "resource": "*:*_repair_damagecd",
                "comparison": ">",
                "compare_to": 0
            }
        }
    },
    "repair_energycd":{
        "type": "origins:cooldown",
        "cooldown": 1200,
        "hud_render": {
            "sprite_location":"origins:textures/gui/community/huang/resource_bar_02.png",
            "bar_index": 1,
            "condition": {
                "type": "origins:resource",
                "resource": "*:*_repair_energycd",
                "comparison": ">",
                "compare_to": 0
            }
        }
    }
}